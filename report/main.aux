\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overview of the credential issuance and header binding. (1) After proving that a \emph  {blinded destination} satisfies the authorization policy, (2) the client obtains \emph  {credential shares} from a threshold set of authorities. (3) It aggregates and unblinds these shares to obtain a \emph  {destination-bound credential}. (4) When sending a packet, a \emph  {header-bound credential} is produced by rerandomizing the credential and bound it to the encrypted routing information.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:architecture}{{2}{7}{Overview of the credential issuance and header binding. (1) After proving that a \emph {blinded destination} satisfies the authorization policy, (2) the client obtains \emph {credential shares} from a threshold set of authorities. (3) It aggregates and unblinds these shares to obtain a \emph {destination-bound credential}. (4) When sending a packet, a \emph {header-bound credential} is produced by rerandomizing the credential and bound it to the encrypted routing information}{figure.caption.4}{}}
\newlabel{eq:header}{{1}{7}{Proposed Scheme}{equation.1}{}}
